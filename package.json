{
  "name": "stack-chan-stage",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run build --workspace=@stackchan-stage/gateway && npm run build --workspace=@stackchan-stage/web",
    "build:stage-mod": "node scripts/build-stage-mod.mjs",
    "build:stage-wasm-host": "node scripts/build-stage-wasm-host.mjs",
    "capture:hero": "npm run build --workspace=@stackchan-stage/web && node scripts/capture-hero-gif.mjs",
    "check": "npm run format:check && npm run typecheck && npm test && npm run check:simulator-assets && npm run check:demo-assets && npm run build",
    "check:demo-assets": "node scripts/verify-demo-assets.mjs",
    "check:simulator-assets": "node scripts/verify-simulator-assets.mjs",
    "generate:demo-bgm": "node scripts/generate-demo-bgm.mjs",
    "dev": "concurrently -n gateway,web -c yellow,cyan \"npm run dev --workspace=@stackchan-stage/gateway\" \"npm run dev --workspace=@stackchan-stage/web\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.0",
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "fast-check": "^4.3.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.2"
}
